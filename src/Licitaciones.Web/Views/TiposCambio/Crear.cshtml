@model Licitaciones.Web.Models.TiposCambio.TipoCambioViewModel
@{ ViewData["Title"] = "Crear tipo de cambio"; }
<div class="page-shell"><a class="back-link" asp-action="Index">← Volver a tipos de cambio</a><div class="form-card"><h1 class="h3 mb-2">Crear tipo de cambio</h1><p class="page-subtitle mb-4">Registre el valor de colones costarricenses por dólar.</p><form asp-action="Crear" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="mb-3"><label asp-for="CrcPorUsd" class="form-label">CRC por USD</label><div class="input-group"><span class="input-group-text">₡</span><input asp-for="CrcPorUsd" class="form-control" type="number" step=".01" autofocus/></div><span asp-validation-for="CrcPorUsd"></span></div><div class="form-check mb-4"><input asp-for="Activo" class="form-check-input"/><label asp-for="Activo" class="form-check-label">Activar al guardar</label></div><div class="action-group justify-content-start"><button class="btn btn-primary" type="submit">Guardar tipo de cambio</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
