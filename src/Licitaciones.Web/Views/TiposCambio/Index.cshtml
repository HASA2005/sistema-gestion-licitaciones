@model IReadOnlyList<Licitaciones.Domain.TiposCambio.TipoCambio>
<h1>Tipos de cambio</h1><a asp-action="Crear">Crear</a>
<table><tr><th>CRC/USD</th><th>Estado</th><th>Acciones</th></tr>
@foreach (var t in Model) { <tr><td>@t.CrcPorUsd</td><td><span class="badge @(t.Activo ? "bg-success" : "bg-secondary")">@(t.Activo ? "Activo" : "Inactivo")</span></td><td><a asp-action="Editar" asp-route-id="@t.Id">Editar</a> <form asp-action="Eliminar" asp-route-id="@t.Id" method="post" style="display:inline" onsubmit="return confirm('¿Eliminar este tipo de cambio?');"><button type="submit">Eliminar</button></form></td></tr> }</table>
