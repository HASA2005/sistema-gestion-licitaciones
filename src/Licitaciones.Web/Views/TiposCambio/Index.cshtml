@model IReadOnlyList<Licitaciones.Domain.TiposCambio.TipoCambio>
@{ ViewData["Title"] = "Tipos de cambio"; }
<div class="page-shell"><header class="page-header"><div><h1>Tipos de cambio</h1><p class="page-subtitle">Administre la referencia de colones por dólar utilizada por el sistema.</p></div><a class="btn btn-primary" asp-action="Crear">+ Crear tipo de cambio</a></header>@if (!Model.Any()) { <div class="empty-state"><h2>No hay tipos de cambio registrados</h2><p>Registre una referencia CRC/USD para comenzar.</p><a class="btn btn-primary" asp-action="Crear">Crear tipo de cambio</a></div> } else { <div class="responsive-table"><table class="data-table"><thead><tr><th>CRC por USD</th><th>Estado</th><th>Creado</th><th>Actualizado</th><th>Acciones</th></tr></thead><tbody>@foreach (var t in Model) { <tr class="@(t.Activo ? "table-success" : null)"><td class="money-value"><strong>₡@t.CrcPorUsd.ToString("N2")</strong></td><td><span class="status-badge @(t.Activo ? "status-active" : "status-inactive")">@(t.Activo ? "Activo" : "Inactivo")</span></td><td>@t.CreatedAt.ToCostaRicaTime().ToString("dd/MM/yyyy HH:mm")</td><td>@t.UpdatedAt.ToCostaRicaTime().ToString("dd/MM/yyyy HH:mm")</td><td><div class="action-group"><a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@t.Id">Editar</a><form asp-action="Eliminar" asp-route-id="@t.Id" method="post" onsubmit="return confirm('¿Eliminar este tipo de cambio?');"><button class="btn btn-sm btn-outline-danger" type="submit" disabled="@t.Activo" title="@(t.Activo ? "El tipo activo no puede eliminarse" : null)">Eliminar</button></form></div></td></tr> }</tbody></table></div> }</div>
