@model IReadOnlyList<Licitaciones.Domain.Aprobaciones.NivelAprobacion>
@{ ViewData["Title"] = "Niveles de aprobación"; }
<div class="page-shell"><header class="page-header"><div><h1>Niveles de aprobación</h1><p class="page-subtitle">Configure responsables y rangos monetarios para cada nivel.</p></div><a class="btn btn-primary" asp-action="Crear">+ Crear nivel</a></header>@if (!Model.Any()) { <div class="empty-state"><h2>No hay niveles configurados</h2><p>Agregue el primer rango de aprobación.</p><a class="btn btn-primary" asp-action="Crear">Crear nivel</a></div> } else { <div class="responsive-table"><table class="data-table"><thead><tr><th>Responsable</th><th>Monto mínimo</th><th>Monto máximo</th><th>Acciones</th></tr></thead><tbody>@foreach (var n in Model) { <tr><td><strong>@n.Responsable</strong></td><td class="money-value">₡@n.MontoMinimoCrc.ToString("N2")</td><td class="money-value">@(n.MontoMaximoCrc.HasValue ? $"₡{n.MontoMaximoCrc.Value:N2}" : "Sin límite")</td><td><div class="action-group"><a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@n.Id">Editar</a><form asp-action="Eliminar" asp-route-id="@n.Id" method="post" onsubmit="return confirm('¿Eliminar este nivel?');"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></div></td></tr> }</tbody></table></div> }</div>
