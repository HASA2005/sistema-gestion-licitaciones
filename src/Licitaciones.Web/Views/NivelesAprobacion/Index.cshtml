@model IReadOnlyList<Licitaciones.Domain.Aprobaciones.NivelAprobacion>
<h1>Niveles de aprobación</h1><a asp-action="Crear">Crear nivel</a>
<table><tr><th>Responsable</th><th>Mínimo</th><th>Máximo</th><th>Acciones</th></tr>
@foreach (var n in Model) { <tr><td>@n.Responsable</td><td>@n.MontoMinimoCrc</td><td>@(n.MontoMaximoCrc?.ToString() ?? "Abierto")</td><td><a asp-action="Editar" asp-route-id="@n.Id">Editar</a> <form asp-action="Eliminar" asp-route-id="@n.Id" method="post" style="display:inline"><button type="submit">Eliminar</button></form></td></tr> }</table>
