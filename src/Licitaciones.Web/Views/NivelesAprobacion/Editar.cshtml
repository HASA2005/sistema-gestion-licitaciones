@model Licitaciones.Web.Models.Aprobaciones.NivelAprobacionViewModel
@{ ViewData["Title"] = "Editar nivel de aprobación"; }
<div class="page-shell"><a class="back-link" asp-action="Index">← Volver a niveles</a><div class="form-card"><h1 class="h3 mb-2">Editar nivel de aprobación</h1><p class="page-subtitle mb-4">Actualice el responsable o los límites del rango.</p><form asp-action="Editar" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="mb-3"><label asp-for="Responsable" class="form-label"></label><input asp-for="Responsable" class="form-control" autofocus/><span asp-validation-for="Responsable"></span></div><div class="mb-3"><label asp-for="MontoMinimoCrc" class="form-label">Monto mínimo (CRC)</label><div class="input-group"><span class="input-group-text">₡</span><input asp-for="MontoMinimoCrc" class="form-control" type="number" step=".01"/></div><span asp-validation-for="MontoMinimoCrc"></span></div><div class="mb-4"><label asp-for="MontoMaximoCrc" class="form-label">Monto máximo (CRC)</label><div class="input-group"><span class="input-group-text">₡</span><input asp-for="MontoMaximoCrc" class="form-control" type="number" step=".01"/></div><div class="form-text">Déjelo vacío para mantener un rango abierto.</div><span asp-validation-for="MontoMaximoCrc"></span></div><div class="action-group justify-content-start"><button class="btn btn-primary" type="submit">Guardar cambios</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
