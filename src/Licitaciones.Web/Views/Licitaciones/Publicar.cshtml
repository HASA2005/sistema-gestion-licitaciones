@model Licitaciones.Web.Models.Licitaciones.PublicarLicitacionViewModel
@{ ViewData["Title"] = "Publicar licitación"; }
<div class="page-shell"><a class="back-link" asp-controller="Crud" asp-action="Licitacion" asp-route-id="@Model.Id">← Volver al detalle</a><header class="page-header"><div><span class="status-badge status-draft mb-2">@Model.Estado</span><h1>Publicar licitación</h1><p class="page-subtitle">Revise los datos antes de habilitar la recepción de ofertas.</p></div></header>@if (TempData["MensajeExito"] is string mensajeExito) { <div class="alert alert-success">@mensajeExito</div> }<section class="content-card"><dl class="detail-grid mb-0"><div class="detail-item"><dt class="data-label">Código</dt><dd class="data-value mb-0">@Model.Codigo</dd></div><div class="detail-item"><dt class="data-label">Título</dt><dd class="data-value mb-0">@Model.Titulo</dd></div><div class="detail-item"><dt class="data-label">Presupuesto</dt><dd class="data-value money-value mb-0">₡@Model.PresupuestoEstimadoCrc.ToString("N2")</dd></div><div class="detail-item"><dt class="data-label">Fecha de cierre</dt><dd class="data-value mb-0">@Model.FechaCierreCostaRica.ToString("dd/MM/yyyy HH:mm")</dd></div><div class="detail-item"><dt class="data-label">Estado</dt><dd class="data-value mb-0"><strong>@Model.Estado</strong></dd></div></dl>@if (Model.PuedePublicarse) { <div class="alert alert-warning mt-4">Al publicar, la licitación quedará disponible para recibir ofertas.</div><form asp-controller="Licitaciones" asp-action="PublicarConfirmado" asp-route-id="@Model.Id" method="post"><div class="action-group justify-content-start"><button class="btn btn-success" type="submit">Publicar licitación</button><a class="btn btn-secondary" asp-controller="Crud" asp-action="Licitacion" asp-route-id="@Model.Id">Cancelar</a></div></form> } else { <div class="alert alert-info mt-4 mb-0">Esta licitación ya no está disponible para publicación.</div> }</section></div>
