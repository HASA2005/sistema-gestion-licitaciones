@model Licitaciones.Web.Models.Licitaciones.CrearLicitacionViewModel
@{ ViewData["Title"] = "Crear licitación"; }
<div class="page-shell"><a class="back-link" asp-controller="Crud" asp-action="Licitaciones">← Volver a licitaciones</a><div class="form-card"><h1 class="h3 mb-2">Crear licitación</h1><p class="page-subtitle mb-3">Registre los datos iniciales del proceso de contratación.</p><div class="alert alert-info">La nueva licitación se guardará con estado <strong>Borrador</strong>.</div><form asp-controller="Licitaciones" asp-action="Crear" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="mb-3"><label asp-for="Codigo" class="form-label">Código</label><input asp-for="Codigo" class="form-control" maxlength="100" autocomplete="off" aria-required="true" aria-describedby="codigo-error" autofocus/><div class="form-text">Identificador único de la licitación.</div><span asp-validation-for="Codigo" id="codigo-error"></span></div><div class="mb-3"><label asp-for="Titulo" class="form-label">Título</label><input asp-for="Titulo" class="form-control" maxlength="200" aria-required="true" aria-describedby="titulo-error"/><span asp-validation-for="Titulo" id="titulo-error"></span></div><div class="mb-3"><label asp-for="PresupuestoEstimadoCrc" class="form-label">Presupuesto estimado (CRC)</label><div class="input-group"><span class="input-group-text">₡</span><input asp-for="PresupuestoEstimadoCrc" class="form-control" type="number" min="0.01" step="0.01" aria-required="true" aria-describedby="presupuesto-error"/></div><span asp-validation-for="PresupuestoEstimadoCrc" id="presupuesto-error"></span></div><div class="mb-4"><label asp-for="FechaCierreLocal" class="form-label">Fecha y hora de cierre</label><input asp-for="FechaCierreLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" type="datetime-local" aria-required="true" aria-describedby="fecha-cierre-error"/><div class="form-text">Use la fecha y hora de Costa Rica.</div><span asp-validation-for="FechaCierreLocal" id="fecha-cierre-error"></span></div><div class="action-group justify-content-start"><button class="btn btn-primary" type="submit">Guardar borrador</button><a class="btn btn-secondary" asp-controller="Crud" asp-action="Licitaciones">Cancelar</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
