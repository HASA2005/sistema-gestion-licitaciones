@model Licitaciones.Web.Models.Licitaciones.CrearLicitacionViewModel

@{
    ViewData["Title"] = "Crear licitación";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Crear licitación</h1>
                <div class="alert alert-info" role="note">
                    La nueva licitación se guardará con estado <strong>Borrador</strong>.
                </div>

                @if (TempData["MensajeExito"] is string mensajeExito)
                {
                    <div class="alert alert-success" role="status">
                        @mensajeExito
                    </div>
                }

                <form asp-controller="Licitaciones"
                      asp-action="Crear"
                      method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Codigo" class="form-label">
                            Código <span class="text-danger" aria-hidden="true">*</span>
                            <span class="visually-hidden">(obligatorio)</span>
                        </label>
                        <input asp-for="Codigo"
                               class="form-control"
                               maxlength="100"
                               autocomplete="off"
                               aria-required="true"
                               aria-describedby="codigo-ayuda codigo-error"
                               autofocus />
                        <div id="codigo-ayuda" class="form-text">
                            Identificador único de la licitación.
                        </div>
                        <span asp-validation-for="Codigo"
                              id="codigo-error"
                              class="text-danger"
                              role="alert"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label">
                            Título <span class="text-danger" aria-hidden="true">*</span>
                            <span class="visually-hidden">(obligatorio)</span>
                        </label>
                        <input asp-for="Titulo"
                               class="form-control"
                               maxlength="200"
                               autocomplete="off"
                               aria-required="true"
                               aria-describedby="titulo-error" />
                        <span asp-validation-for="Titulo"
                              id="titulo-error"
                              class="text-danger"
                              role="alert"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PresupuestoEstimadoCrc" class="form-label">
                            Presupuesto estimado (CRC)
                            <span class="text-danger" aria-hidden="true">*</span>
                            <span class="visually-hidden">(obligatorio)</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text" aria-hidden="true">₡</span>
                            <input asp-for="PresupuestoEstimadoCrc"
                                   type="number"
                                   class="form-control"
                                   min="0.01"
                                   max="9999999999999999.99"
                                   step="0.01"
                                   inputmode="decimal"
                                   aria-required="true"
                                   aria-describedby="presupuesto-ayuda presupuesto-error" />
                        </div>
                        <div id="presupuesto-ayuda" class="form-text">
                            Ingrese el monto estimado en colones costarricenses.
                        </div>
                        <span asp-validation-for="PresupuestoEstimadoCrc"
                              id="presupuesto-error"
                              class="text-danger"
                              role="alert"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="FechaCierreLocal" class="form-label">
                            Fecha y hora de cierre
                            <span class="text-danger" aria-hidden="true">*</span>
                            <span class="visually-hidden">(obligatorio)</span>
                        </label>
                        <input asp-for="FechaCierreLocal"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               type="datetime-local"
                               class="form-control"
                               aria-required="true"
                               aria-describedby="fecha-cierre-ayuda fecha-cierre-error" />
                        <div id="fecha-cierre-ayuda" class="form-text">
                            Use la fecha y hora de Costa Rica.
                        </div>
                        <span asp-validation-for="FechaCierreLocal"
                              id="fecha-cierre-error"
                              class="text-danger"
                              role="alert"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Guardar borrador
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
