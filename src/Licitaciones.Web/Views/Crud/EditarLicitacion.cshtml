@model Licitaciones.Web.Models.Crud.EditarLicitacionViewModel
@{ ViewData["Title"] = "Editar licitación"; }
<div class="page-shell"><a class="back-link" asp-action="Licitacion" asp-route-id="@Model.Id">← Volver al detalle</a><div class="form-card"><h1 class="h3 mb-2">Editar licitación</h1><p class="page-subtitle mb-4">Actualice los datos del borrador.</p><form asp-action="EditarLicitacion" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="Id" type="hidden"/><div class="mb-3"><label asp-for="Codigo" class="form-label">Código</label><input asp-for="Codigo" class="form-control"/><span asp-validation-for="Codigo"></span></div><div class="mb-3"><label asp-for="Titulo" class="form-label">Título</label><input asp-for="Titulo" class="form-control"/><span asp-validation-for="Titulo"></span></div><div class="mb-3"><label asp-for="PresupuestoEstimadoCrc" class="form-label">Presupuesto estimado (CRC)</label><div class="input-group"><span class="input-group-text">₡</span><input asp-for="PresupuestoEstimadoCrc" class="form-control" type="number" step=".01"/></div><span asp-validation-for="PresupuestoEstimadoCrc"></span></div><div class="mb-4"><label asp-for="FechaCierre" class="form-label">Fecha y hora de cierre</label><input asp-for="FechaCierre" class="form-control" type="datetime-local"/><span asp-validation-for="FechaCierre"></span></div><div class="action-group justify-content-start"><button class="btn btn-primary" type="submit">Guardar cambios</button><a class="btn btn-secondary" asp-action="Licitacion" asp-route-id="@Model.Id">Cancelar</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
