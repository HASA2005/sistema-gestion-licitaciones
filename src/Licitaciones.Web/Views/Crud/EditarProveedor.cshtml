@model Licitaciones.Web.Models.Crud.EditarProveedorViewModel
@{ ViewData["Title"] = "Editar proveedor"; }
<div class="page-shell"><a class="back-link" asp-action="Proveedor" asp-route-id="@Model.Id">← Volver al detalle</a><div class="form-card"><h1 class="h3 mb-2">Editar proveedor</h1><p class="page-subtitle mb-4">Actualice el nombre con el que se identifica al proveedor.</p><form asp-action="EditarProveedor" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="Id" type="hidden"/><div class="mb-4"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" autocomplete="organization" autofocus/><span asp-validation-for="Nombre"></span></div><div class="action-group justify-content-start"><button class="btn btn-primary" type="submit">Guardar cambios</button><a class="btn btn-secondary" asp-action="Proveedor" asp-route-id="@Model.Id">Cancelar</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
