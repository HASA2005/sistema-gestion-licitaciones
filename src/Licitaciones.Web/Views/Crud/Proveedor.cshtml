@model Licitaciones.Domain.Proveedores.Proveedor
<h1>@Model.Nombre</h1><p>Id: @Model.Id</p>
<a asp-action="EditarProveedor" asp-route-id="@Model.Id">Editar</a><form asp-action="EliminarProveedor" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar proveedor?');"><button type="submit">Eliminar</button></form>
