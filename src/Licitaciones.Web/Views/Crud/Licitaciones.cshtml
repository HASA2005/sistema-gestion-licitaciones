@model IReadOnlyList<Licitaciones.Domain.Licitaciones.Licitacion>
@using Licitaciones.Domain.Licitaciones
@{ ViewData["Title"] = "Licitaciones"; }
<div class="page-shell"><header class="page-header"><div><h1>Licitaciones</h1><p class="page-subtitle">Consulte y administre los procesos de contratación.</p></div><a class="btn btn-primary" asp-controller="Licitaciones" asp-action="Crear">+ Crear licitación</a></header>@if (!Model.Any()) { <div class="empty-state"><h2>No hay licitaciones registradas todavía</h2><p>Cree el primer borrador para comenzar.</p><a class="btn btn-primary" asp-controller="Licitaciones" asp-action="Crear">Crear licitación</a></div> } else { <div class="responsive-table"><table class="data-table"><thead><tr><th>Código</th><th>Título</th><th>Presupuesto</th><th>Cierre</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var x in Model){var badge=x.Estado==EstadoLicitacion.Borrador?"status-draft":"status-published";<tr><td><strong>@x.Codigo</strong></td><td>@x.Titulo</td><td class="money-value">₡@x.PresupuestoEstimadoCrc.ToString("N2")</td><td>@x.FechaCierre.ToCostaRicaTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="status-badge @badge">@x.Estado</span></td><td><div class="action-group"><a class="btn btn-sm btn-outline-primary" asp-action="Licitacion" asp-route-id="@x.Id">Ver</a><a class="btn btn-sm btn-outline-secondary" asp-action="EditarLicitacion" asp-route-id="@x.Id">Editar</a>@if(x.Estado==EstadoLicitacion.Borrador){<a class="btn btn-sm btn-outline-success" asp-controller="Licitaciones" asp-action="Publicar" asp-route-id="@x.Id">Publicar</a>}<form asp-action="EliminarLicitacion" asp-route-id="@x.Id" method="post" onsubmit="return confirm('¿Eliminar esta licitación?');"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></div></td></tr>}</tbody></table></div> }</div>
