@model IReadOnlyList<Licitaciones.Domain.Proveedores.Proveedor>
@{ ViewData["Title"] = "Proveedores"; }
<div class="page-shell"><header class="page-header"><div><h1>Proveedores</h1><p class="page-subtitle">Administre los proveedores registrados.</p></div><a class="btn btn-primary" asp-controller="Proveedores" asp-action="Registrar">+ Registrar proveedor</a></header>
@if (!Model.Any()) { <div class="empty-state"><h2>No hay proveedores registrados todavía</h2><p>Registre el primer proveedor para comenzar.</p><a class="btn btn-primary" asp-controller="Proveedores" asp-action="Registrar">Registrar proveedor</a></div> } else { <div class="responsive-table"><table class="data-table"><thead><tr><th>Nombre</th><th>Registro</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Nombre</strong></td><td>@x.CreatedAt.ToCostaRicaTime().ToString("dd/MM/yyyy")</td><td><div class="action-group"><a class="btn btn-sm btn-outline-primary" asp-action="Proveedor" asp-route-id="@x.Id">Ver</a><a class="btn btn-sm btn-outline-secondary" asp-action="EditarProveedor" asp-route-id="@x.Id">Editar</a><form asp-action="EliminarProveedor" asp-route-id="@x.Id" method="post" onsubmit="return confirm('¿Eliminar este proveedor?');"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></div></td></tr>}</tbody></table></div> }</div>
