@model Licitaciones.Domain.Licitaciones.Licitacion
@using Licitaciones.Domain.Licitaciones
@{ ViewData["Title"] = "Detalle de licitación"; var badge = Model.Estado == EstadoLicitacion.Borrador ? "status-draft" : "status-published"; }
<div class="page-shell"><a class="back-link" asp-action="Licitaciones">← Volver a licitaciones</a><header class="page-header"><div><div class="mb-2"><span class="status-badge @badge">@Model.Estado</span></div><h1>@Model.Codigo</h1><p class="page-subtitle">@Model.Titulo</p></div><div class="action-group"><a class="btn btn-secondary" asp-action="EditarLicitacion" asp-route-id="@Model.Id">Editar</a>@if(Model.Estado == EstadoLicitacion.Borrador){<a class="btn btn-success" asp-controller="Licitaciones" asp-action="Publicar" asp-route-id="@Model.Id">Publicar</a>}<form asp-action="EliminarLicitacion" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar esta licitación?');"><button class="btn btn-danger" type="submit">Eliminar</button></form></div></header><section class="content-card"><div class="detail-grid"><div class="detail-item"><span class="data-label">Código</span><span class="data-value">@Model.Codigo</span></div><div class="detail-item"><span class="data-label">Presupuesto</span><span class="data-value money-value">₡@Model.PresupuestoEstimadoCrc.ToString("N2")</span></div><div class="detail-item"><span class="data-label">Fecha de cierre</span><span class="data-value">@Model.FechaCierre.ToCostaRicaTime().ToString("dd/MM/yyyy HH:mm")</span></div><div class="detail-item"><span class="data-label">Estado</span><span class="data-value">@Model.Estado</span></div><div class="detail-item"><span class="data-label">Creada</span><span class="data-value">@Model.CreatedAt.ToCostaRicaTime().ToString("dd/MM/yyyy HH:mm")</span></div><div class="detail-item"><span class="data-label">Actualizada</span><span class="data-value">@Model.UpdatedAt.ToCostaRicaTime().ToString("dd/MM/yyyy HH:mm")</span></div></div><div class="technical-info"><strong>ID técnico:</strong> @Model.Id</div></section></div>
