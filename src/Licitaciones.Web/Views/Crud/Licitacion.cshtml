@model Licitaciones.Domain.Licitaciones.Licitacion
<h1>@Model.Codigo</h1><p>@Model.Titulo</p><p>Presupuesto: @Model.PresupuestoEstimadoCrc</p><p>Estado: @Model.Estado</p>
<a asp-action="EditarLicitacion" asp-route-id="@Model.Id">Editar</a><form asp-action="EliminarLicitacion" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar licitación?');"><button type="submit">Eliminar</button></form>
