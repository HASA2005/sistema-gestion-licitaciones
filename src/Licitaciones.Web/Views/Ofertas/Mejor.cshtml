@model Licitaciones.Application.Ofertas.MejorOfertaDto
@{ ViewData["Title"] = "Mejor oferta"; decimal? ahorroCrc = null; if (Model.Oferta is not null && Model.AhorroPorcentaje is > 0 and < 100) { var presupuesto = Model.Oferta.MontoCrc / (1 - Model.AhorroPorcentaje.Value / 100); ahorroCrc = presupuesto - Model.Oferta.MontoCrc; } }
<div class="page-shell"><a class="back-link" asp-action="Index">← Volver a ofertas</a><header class="page-header"><div><h1>Mejor oferta</h1><p class="page-subtitle">Resultado de la comparación de propuestas válidas.</p></div></header>@if (Model.Oferta is null) { <div class="empty-state"><h2>Sin ofertas válidas</h2><p>No existen propuestas que puedan clasificarse para esta licitación.</p></div> } else { <section class="content-card winning-card"><div class="p-2"><span class="data-label">Proveedor ganador</span><h2 class="h4 mb-4">@Model.Oferta.ProveedorId</h2><div class="detail-grid"><div class="detail-item"><span class="data-label">Monto ganador</span><span class="data-value money-value">₡@Model.Oferta.MontoCrc.ToString("N2")</span></div><div class="detail-item"><span class="data-label">Ahorro CRC</span><span class="data-value money-value">@(ahorroCrc.HasValue ? $"₡{ahorroCrc.Value:N2}" : "₡0,00")</span></div><div class="detail-item"><span class="data-label">Porcentaje de ahorro</span><span class="data-value">@Model.AhorroPorcentaje?.ToString("0.00") %</span></div><div class="detail-item"><span class="data-label">Clasificación</span><span class="classification-badge">@Model.Clasificacion</span></div></div><div class="technical-info"><strong>ID de oferta:</strong> @Model.Oferta.Id</div></div></section> }</div>
