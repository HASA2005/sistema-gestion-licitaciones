@model Licitaciones.Application.Ofertas.MejorOfertaDto
<main class="container py-4"><div class="mb-4"><p class="text-uppercase text-muted small mb-1">Análisis</p><h1 class="mb-1">Mejor oferta</h1><p class="text-muted">La propuesta válida con menor monto registrado.</p></div>
@if (Model.Oferta is null) { <section class="card border-0 shadow-sm"><div class="card-body p-5 text-center text-muted">Sin ofertas válidas</div></section> } else { <section class="card border-0 shadow-sm"><div class="card-body p-4"><div class="row g-4"><div class="col-md-6"><small class="text-muted text-uppercase">Proveedor</small><div class="h4 mt-2">@Model.Oferta.ProveedorId</div></div><div class="col-md-6"><small class="text-muted text-uppercase">Monto ofertado</small><div class="h3 mt-2">₡@Model.Oferta.MontoCrc.ToString("N2")</div></div><div class="col-md-6"><small class="text-muted text-uppercase">Ahorro</small><div class="h4 mt-2">@Model.AhorroPorcentaje?.ToString("0.00") %</div></div><div class="col-md-6"><small class="text-muted text-uppercase">Clasificación</small><div class="mt-2"><span class="badge bg-success fs-6">@Model.Clasificacion</span></div></div></div></div></section> }</main>
