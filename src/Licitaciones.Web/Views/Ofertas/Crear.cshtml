@model Licitaciones.Web.Models.Ofertas.OfertaViewModel
@{ ViewData["Title"] = "Crear oferta"; }
<div class="page-shell"><a class="back-link" asp-action="Index">← Volver a ofertas</a><div class="form-card"><h1 class="h3 mb-2">Crear oferta</h1><p class="page-subtitle mb-4">Registre una propuesta para una licitación publicada.</p><form asp-action="Crear" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="mb-3"><label asp-for="LicitacionId" class="form-label">ID de licitación</label><input asp-for="LicitacionId" class="form-control"/><span asp-validation-for="LicitacionId"></span></div><div class="mb-3"><label asp-for="ProveedorId" class="form-label">ID de proveedor</label><input asp-for="ProveedorId" class="form-control"/><span asp-validation-for="ProveedorId"></span></div><div class="mb-4"><label asp-for="MontoCrc" class="form-label">Monto ofertado (CRC)</label><div class="input-group"><span class="input-group-text">₡</span><input asp-for="MontoCrc" class="form-control" type="number" step="0.01"/></div><span asp-validation-for="MontoCrc"></span></div><div class="action-group justify-content-start"><button class="btn btn-primary" type="submit">Guardar oferta</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
