@model Licitaciones.Web.Models.Ofertas.OfertaViewModel
<h1>Crear oferta</h1>
<form asp-action="Crear" method="post">
    <div asp-validation-summary="All"></div>
    <input asp-for="LicitacionId" type="hidden" />
    <label asp-for="ProveedorId"></label><input asp-for="ProveedorId" />
    <label asp-for="MontoCrc"></label><input asp-for="MontoCrc" type="number" step="0.01" />
    <button type="submit">Guardar oferta</button>
</form>
