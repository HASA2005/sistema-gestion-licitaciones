@model Licitaciones.Web.Models.Ofertas.OfertaViewModel
<h1>Editar oferta</h1>
<form asp-action="Editar" method="post">
    <div asp-validation-summary="All"></div>
    <input asp-for="LicitacionId" type="hidden" /><input asp-for="ProveedorId" type="hidden" />
    <label asp-for="MontoCrc"></label><input asp-for="MontoCrc" type="number" step="0.01" />
    <button type="submit">Guardar cambios</button>
</form>
