@model Licitaciones.Web.Models.Ofertas.OfertaViewModel
@{ ViewData["Title"] = "Editar oferta"; }
<div class="page-shell"><a class="back-link" asp-action="Index">← Volver a ofertas</a><div class="form-card"><h1 class="h3 mb-2">Editar oferta</h1><p class="page-subtitle mb-4">Actualice el monto de la propuesta mientras la licitación permanezca abierta.</p><form asp-action="Editar" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><input asp-for="LicitacionId" type="hidden"/><input asp-for="ProveedorId" type="hidden"/><div class="detail-grid mb-4"><div class="detail-item"><span class="data-label">Licitación</span><span class="technical-info border-0 p-0 m-0">@Model.LicitacionId</span></div><div class="detail-item"><span class="data-label">Proveedor</span><span class="technical-info border-0 p-0 m-0">@Model.ProveedorId</span></div></div><div class="mb-4"><label asp-for="MontoCrc" class="form-label">Monto ofertado (CRC)</label><div class="input-group"><span class="input-group-text">₡</span><input asp-for="MontoCrc" class="form-control" type="number" step="0.01" autofocus/></div><span asp-validation-for="MontoCrc"></span></div><div class="action-group justify-content-start"><button class="btn btn-primary" type="submit">Guardar cambios</button><a class="btn btn-secondary" asp-action="Index">Cancelar</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
