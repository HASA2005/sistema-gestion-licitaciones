@model Licitaciones.Web.Models.Ofertas.OfertaDetalleViewModel
@{ ViewData["Title"] = "Detalle de oferta"; }
<div class="page-shell"><a class="back-link" asp-action="Index">← Volver a ofertas</a><header class="page-header"><div><h1>Detalle de oferta</h1><p class="page-subtitle">Información monetaria y referencias asociadas.</p></div><div class="action-group"><a class="btn btn-secondary" asp-action="Editar" asp-route-id="@Model.Id">Editar</a><form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Eliminar esta oferta?');"><button class="btn btn-danger" type="submit">Eliminar</button></form></div></header><section class="content-card"><div class="detail-grid"><div class="detail-item"><span class="data-label">Licitación</span><span class="data-value">@Model.CodigoLicitacion</span><span class="data-value">@Model.TituloLicitacion</span></div><div class="detail-item"><span class="data-label">Proveedor</span><span class="data-value">@Model.NombreProveedor</span></div><div class="detail-item"><span class="data-label">Monto ofertado</span><span class="data-value money-value">₡@Model.MontoCrc.ToString("N2")</span></div><div class="detail-item"><span class="data-label">Fecha de registro</span><span class="data-value">@Model.CreatedAt.ToCostaRicaTime().ToString("dd/MM/yyyy HH:mm")</span></div><div class="detail-item"><span class="data-label">Última actualización</span><span class="data-value">@Model.UpdatedAt.ToCostaRicaTime().ToString("dd/MM/yyyy HH:mm")</span></div></div></section></div>
