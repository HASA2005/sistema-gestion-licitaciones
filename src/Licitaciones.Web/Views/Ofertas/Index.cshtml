@model IReadOnlyList<Licitaciones.Web.Models.Ofertas.OfertaListadoViewModel>
@{ ViewData["Title"] = "Ofertas"; }
<div class="page-shell"><header class="page-header"><div><h1>Ofertas</h1><p class="page-subtitle">Compare propuestas y consulte sus detalles.</p></div><a class="btn btn-primary" asp-action="Crear">+ Crear oferta</a></header>@if (!Model.Any()) { <div class="empty-state"><h2>No hay ofertas registradas todavía</h2><p>Registre una oferta para una licitación publicada.</p><a class="btn btn-primary" asp-action="Crear">Crear oferta</a></div> } else { <div class="responsive-table"><table class="data-table"><thead><tr><th>Licitación</th><th>Proveedor</th><th>Monto CRC</th><th>Fecha</th><th>Acciones</th></tr></thead><tbody>@foreach (var oferta in Model) { <tr><td><span class="technical-info border-0 p-0 m-0">@oferta.CodigoLicitacion</span></td><td><span class="technical-info border-0 p-0 m-0">@oferta.NombreProveedor</span></td><td class="money-value"><strong>₡@oferta.MontoCrc.ToString("N2")</strong></td><td>@oferta.CreatedAt.ToCostaRicaTime().ToString("dd/MM/yyyy HH:mm")</td><td><div class="action-group"><a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@oferta.Id">Ver</a><a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@oferta.Id">Editar</a><form asp-action="Eliminar" asp-route-id="@oferta.Id" method="post" onsubmit="return confirm('¿Eliminar esta oferta?');"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></div></td></tr> }</tbody></table></div> }</div>
