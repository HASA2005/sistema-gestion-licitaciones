@model IReadOnlyList<Licitaciones.Application.Ofertas.OfertaDto>
<main class="container py-4"><div class="d-flex justify-content-between align-items-end mb-4"><div><p class="text-uppercase text-muted small mb-1">Gestión</p><h1 class="mb-1">Ofertas</h1><p class="text-muted mb-0">Compare propuestas y consulte sus detalles.</p></div><a class="btn btn-primary" asp-action="Crear">+ Crear oferta</a></div>
<section class="card shadow-sm border-0"><div class="card-body p-0">@if (!Model.Any()) { <div class="p-5 text-center text-muted">No hay ofertas registradas todavía.</div> } else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Licitación</th><th>Proveedor</th><th>Monto CRC</th><th>Fecha</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach (var oferta in Model) { <tr><td class="text-technical">@oferta.LicitacionId</td><td class="text-technical">@oferta.ProveedorId</td><td class="fw-semibold">₡@oferta.MontoCrc.ToString("N2")</td><td>@oferta.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@oferta.Id">Ver</a> <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@oferta.Id">Editar</a></td></tr> }</tbody></table></div>}</div></section></main>
