@model IReadOnlyList<Licitaciones.Application.Ofertas.OfertaDto>
<h1>Ofertas</h1>
<table><thead><tr><th>Licitación</th><th>Proveedor</th><th>Monto CRC</th><th>Fecha</th></tr></thead><tbody>
@foreach (var oferta in Model) { <tr><td>@oferta.LicitacionId</td><td>@oferta.ProveedorId</td><td>@oferta.MontoCrc</td><td>@oferta.CreatedAt</td><td><a asp-action="Detalle" asp-route-id="@oferta.Id">Consultar</a> <a asp-action="Editar" asp-route-id="@oferta.Id">Editar</a><form asp-action="Eliminar" asp-route-id="@oferta.Id" method="post" style="display:inline"><button type="submit">Eliminar</button></form></td></tr> }
</tbody></table>
