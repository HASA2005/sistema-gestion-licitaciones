@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="page-shell"><div class="form-card text-center"><span class="status-badge status-closed mb-3">No se pudo completar la operación</span><h1 class="h3">Ocurrió un error inesperado</h1><p class="page-subtitle mx-auto mb-4">Intente nuevamente. Si el problema continúa, conserve el identificador técnico para revisar el incidente.</p>@if (Model.ShowRequestId) { <div class="technical-info"><strong>ID de solicitud:</strong> @Model.RequestId</div> }<a class="btn btn-primary mt-4" asp-controller="Home" asp-action="Index">Volver al inicio</a></div></div>
