@model Licitaciones.Web.Models.Proveedores.RegistrarProveedorViewModel
@{ ViewData["Title"] = "Registrar proveedor"; }
<div class="page-shell"><a class="back-link" asp-controller="Crud" asp-action="Proveedores">← Volver a proveedores</a><div class="form-card"><h1 class="h3 mb-2">Registrar proveedor</h1><p class="page-subtitle mb-4">Ingrese el nombre con el que se identificará al proveedor.</p>@if (TempData["MensajeExito"] is string mensajeExito) { <div class="alert alert-success" role="status">@mensajeExito</div> }<form asp-controller="Proveedores" asp-action="Registrar" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="mb-4"><label asp-for="Nombre" class="form-label">Nombre del proveedor</label><input asp-for="Nombre" class="form-control" autocomplete="organization" aria-required="true" aria-describedby="nombre-ayuda nombre-error" autofocus/><div id="nombre-ayuda" class="form-text">Puede usar letras, números, espacios, punto, coma y paréntesis.</div><span asp-validation-for="Nombre" id="nombre-error"></span></div><div class="action-group justify-content-start"><button class="btn btn-primary" type="submit">Registrar proveedor</button><a class="btn btn-secondary" asp-controller="Crud" asp-action="Proveedores">Cancelar</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
